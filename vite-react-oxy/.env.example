# Public Oxy API; use your own API URL when self-hosting.
VITE_OXY_API_URL=https://api.oxy.so

# Required: an existing registered public OAuth client (ApplicationCredential.publicKey).
# Register this app as third_party; never embed a confidential client secret.
VITE_OXY_CLIENT_ID=

# Required: EXACT URI registered in that application's redirectUris.
# Keep OxyProvider mounted at this return route; the SDK consumes OAuth returns.
# Change this URI and its registry entry together for your deployed origin.
VITE_OXY_REDIRECT_URI=http://localhost:5173/
