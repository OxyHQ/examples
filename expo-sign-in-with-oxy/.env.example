# Public metadata for an existing registered third-party application. No secrets.
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so
EXPO_PUBLIC_OXY_CLIENT_ID=
# Exact URI registered in Oxy. Set the native URI below for a development build;
# for web, use that build's separately registered http(s) callback URL.
EXPO_PUBLIC_OXY_REDIRECT_URI=oxyexample://oauth/callback
